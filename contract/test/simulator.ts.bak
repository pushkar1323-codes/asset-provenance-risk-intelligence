/**
 * Thin wrapper around the compiled Asset Passport contract that threads
 * CircuitContext state between calls, so tests can call circuits like plain
 * methods and inspect the resulting public ledger state.
 *
 * Built against the actual @midnight-ntwrk/compact-runtime 0.16.0 API
 * surface (createConstructorContext, createCircuitContext,
 * sampleContractAddress, CostModel) and the Contract/ledger artifacts
 * produced by `compact compile`. See the project README for why the
 * `../managed/**` import below cannot be resolved inside the environment
 * that generated this file, and what to verify once it is run locally.
 */

import {
  CostModel,
  createCircuitContext,
  createConstructorContext,
  sampleContractAddress,
  type CircuitContext,
  type CircuitResults
} from '@midnight-ntwrk/compact-runtime';

// eslint-disable-next-line @typescript-eslint/ban-ts-comment
// @ts-ignore -- generated by `compact compile` into ../managed/asset-passport
import { Contract, ledger, type Ledger } from '../managed/asset-passport/contract/index.js';

import {
  createAssetPassportPrivateState,
  witnesses,
  type AssetPassportPrivateState
} from '../src/witnesses.js';

const ZERO_COIN_PUBLIC_KEY = '0'.repeat(64);

export class AssetPassportSimulator {
  readonly contract: InstanceType<typeof Contract>;
  private readonly contractAddress: string;
  private context: CircuitContext<AssetPassportPrivateState>;

  constructor(
    adminKey: Uint8Array,
    oracleKey: Uint8Array,
    privateState: AssetPassportPrivateState = createAssetPassportPrivateState()
  ) {
    this.contract = new Contract(witnesses);
    this.contractAddress = sampleContractAddress();

    const initial = this.contract.initialState(
      createConstructorContext(privateState, ZERO_COIN_PUBLIC_KEY),
      adminKey,
      oracleKey
    );

    this.context = createCircuitContext(
      this.contractAddress,
      initial.currentZswapLocalState,
      initial.currentContractState,
      initial.currentPrivateState,
      undefined,
      CostModel.initialCostModel()
    );
  }

  /** Returns the current, fully public ledger state. */
  getLedger(): Ledger {
    return ledger(this.context.currentQueryContext.state.state);
  }

  /** Returns the current private state held by this simulated participant. */
  getPrivateState(): AssetPassportPrivateState {
    return this.context.currentPrivateState;
  }

  private call<T>(
    invoke: (ctx: CircuitContext<AssetPassportPrivateState>) => CircuitResults<AssetPassportPrivateState, T>
  ): T {
    const { context, result } = invoke(this.context);
    this.context = context;
    return result;
  }

  registerAsset(assetId: Uint8Array, assetCategory: bigint, registeredAt: bigint): void {
    this.call((ctx) => this.contract.impureCircuits.registerAsset(ctx, assetId, assetCategory, registeredAt));
  }

  transferOwnership(assetId: Uint8Array, newOwnerCommitment: Uint8Array): void {
    this.call((ctx) => this.contract.impureCircuits.transferOwnership(ctx, assetId, newOwnerCommitment));
  }

  retireAsset(assetId: Uint8Array): void {
    this.call((ctx) => this.contract.impureCircuits.retireAsset(ctx, assetId));
  }

  addCredential(
    assetId: Uint8Array,
    credentialId: Uint8Array,
    credentialType: bigint,
    issuerCommitment: Uint8Array,
    addedAt: bigint
  ): void {
    this.call((ctx) =>
      this.contract.impureCircuits.addCredential(
        ctx,
        assetId,
        credentialId,
        credentialType,
        issuerCommitment,
        addedAt
      )
    );
  }

  verifyCredential(credentialId: Uint8Array): void {
    this.call((ctx) => this.contract.impureCircuits.verifyCredential(ctx, credentialId));
  }

  revokeCredential(credentialId: Uint8Array): void {
    this.call((ctx) => this.contract.impureCircuits.revokeCredential(ctx, credentialId));
  }

  addProvenanceEvent(
    assetId: Uint8Array,
    eventId: Uint8Array,
    eventType: bigint,
    recordedAt: bigint
  ): void {
    this.call((ctx) =>
      this.contract.impureCircuits.addProvenanceEvent(ctx, assetId, eventId, eventType, recordedAt)
    );
  }

  recordRiskAssessment(
    assetId: Uint8Array,
    riskCommitment: Uint8Array,
    riskTier: bigint,
    assessedAt: bigint
  ): void {
    this.call((ctx) =>
      this.contract.impureCircuits.recordRiskAssessment(ctx, assetId, riskCommitment, riskTier, assessedAt)
    );
  }
}
