# Copy this file to .env and fill in real values locally.
# Never commit a real .env file.

# Network to target. One of: undeployed | testnet | preview | preprod
MIDNIGHT_NETWORK=undeployed

# Populated after a real deployment (see README). Leave empty until you
# have actually deployed and can supply a real value.
CONTRACT_ADDRESS=

# Directory containing the compiled ZK assets for the Asset Passport
# contract (the `keys/` and `zkir/` produced by `compact compile` under
# contract/managed/asset-passport/).
ZK_CONFIG_PATH=./contract/managed/asset-passport

# Midnight indexer GraphQL endpoints (public data queries and subscriptions).
# Official current documentation lists, for Preprod:
#   https://indexer.preprod.midnight.network/api/v4/graphql
#   wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# Verify against current docs before use - endpoint paths have changed
# versions before, and are not hardcoded here for that reason.
MIDNIGHT_INDEXER_URL=
MIDNIGHT_INDEXER_WS_URL=

# Midnight proof server endpoint. Official documentation and community
# reports of the current Preprod address have disagreed with each other;
# verify the current correct value before use rather than assuming one.
MIDNIGHT_PROOF_SERVER_URL=

# A stable identifier for the local account/session whose private state
# and signing keys are stored on disk (e.g. a wallet address). Used only
# to namespace local storage - not a secret itself.
PRIVATE_STATE_ACCOUNT_ID=

# Password used to encrypt local private-state/signing-key storage.
# Required, at least 16 characters, mixed character types. Never commit
# a real value here.
PRIVATE_STATE_STORAGE_PASSWORD=

# Identifier this project's private state is stored under locally.
# Optional - defaults to "asset-passport" if unset.
PRIVATE_STATE_ID=

# --- Node deployment wallet (contract/src/deploy/wallet/) ---
# Only needed to attempt a real deployment; --validate-only and the
# rest of the deployment runner work without these. This is a local
# deployment identity, separate from any browser wallet (Lace) used by
# the frontend.

# Node/relay endpoint the wallet submits transactions through.
MIDNIGHT_RELAY_URL=

# Local seed for the deployment wallet: 64 hex characters (32 bytes).
# Generate one locally with, from the contract workspace:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value here. Never share this value with anyone,
# including when asking for help - treat it like a private key, because
# it derives one.
DEPLOYMENT_WALLET_SEED_HEX=

# --- Frontend (Vite) configuration ---
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# These are build-time configuration, not secrets.

# Network id this application expects the connected wallet to be on.
VITE_MIDNIGHT_NETWORK_ID=undeployed

# Address of the already-deployed Asset Passport contract the frontend
# connects to.
VITE_ASSET_PASSPORT_CONTRACT_ADDRESS=

# Base URL the browser can fetch compiled ZK assets from (served
# separately from contract/managed/asset-passport - a static file host or
# equivalent, since the browser cannot read the local filesystem).
VITE_ZK_CONFIG_BASE_URL=
